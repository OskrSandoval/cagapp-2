# Copia este archivo a .env y llena los valores reales (nunca los commitees).
# URL y anon key del proyecto de Supabase (Project Settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL base del backend local (rutas → controladores → servicios → datos).
# En dev normalmente http://localhost:3001 (debe coincidir con PORT en backend/.env).
VITE_API_URL=http://localhost:3001
