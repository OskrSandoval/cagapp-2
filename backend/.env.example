# Copia este archivo a .env y llena los valores reales (nunca los commitees).
# Project Settings → API en el dashboard de Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Puerto donde escucha el servidor Express.
PORT=3001

# Origen exacto del frontend, para configurar CORS (ej. http://localhost:5173).
FRONTEND_ORIGIN=http://localhost:5173
